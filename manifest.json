{
    "manifest_version": 3,
    "name": "AliExpress Order Exporter",
    "description": "Export your AliExpress orders with direct invoice links.",
    "version": "1.0",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["https://*.aliexpress.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
